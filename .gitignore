node_modules/
dist/
build/
.env
.env.local
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
coverage/
.turbo/

# Emitted JS must never sit next to the TSX sources - Vite resolves .js
# before .tsx and would silently serve stale compiled output.
apps/web/src/**/*.js
apps/web/src/**/*.js.map

# Same trap one level up: a stale vite.config.js shadows vite.config.ts.
apps/*/vite.config.js
apps/*/drizzle.config.js

# Docker deploy hook artefacts
.docker-deploy-stamp
docker-deploy.log

# Handoff file from test/global-setup.ts (integration tests) to
# test/setup-env.ts - carries a fresh testcontainers connection string, torn
# down again once the run finishes.
apps/api/test/.runtime-env.json
