{
  "name": "cars-fetcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @cars-fetcher/api",
    "dev:web": "npm run dev --workspace @cars-fetcher/web",
    "build": "npm run build --workspace @cars-fetcher/api && npm run build --workspace @cars-fetcher/web",
    "typecheck": "npm run typecheck --workspace @cars-fetcher/api && npm run typecheck --workspace @cars-fetcher/web",
    "test": "npm test --workspace @cars-fetcher/api && npm test --workspace @cars-fetcher/web",
    "test:integration": "npm run test:integration --workspace @cars-fetcher/api",
    "test:all": "npm run test && npm run test:integration",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:generate": "npm run db:generate --workspace @cars-fetcher/api",
    "db:migrate": "npm run db:migrate --workspace @cars-fetcher/api",
    "db:seed": "npm run db:seed --workspace @cars-fetcher/api",
    "db:studio": "npm run db:studio --workspace @cars-fetcher/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
