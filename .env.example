# ---------------------------------------------------------------------------
# Docker / PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=cars
POSTGRES_PASSWORD=cars
POSTGRES_DB=cars_fetcher
POSTGRES_PORT=5433
ADMINER_PORT=8080

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cars:cars@localhost:5433/cars_fetcher
CORS_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Otomoto
#
# OTOMOTO_SOURCE picks the adapter:
#   scraper - public listing pages, real adverts, no credentials needed
#   api     - official partner OAuth2 API (https://www.otomoto.pl/api/doc/);
#             note it only exposes the adverts of the authenticated dealer
#             account, not marketplace-wide search
#   fixture - deterministic generator, offline development
# ---------------------------------------------------------------------------
OTOMOTO_SOURCE=scraper

# Only needed when OTOMOTO_SOURCE=api
OTOMOTO_ENABLED=false
OTOMOTO_BASE_URL=https://www.otomoto.pl/api/open
OTOMOTO_CLIENT_ID=
OTOMOTO_CLIENT_SECRET=
OTOMOTO_USERNAME=
OTOMOTO_PASSWORD=

# ---------------------------------------------------------------------------
# Scraping - shared by every HTML adapter (Otomoto, autoplac.pl, OLX)
#
# SCRAPER_MIN_DELAY_MS is the minimum gap between two requests to the same
# host. Do not lower it without a reason: the throttle is what keeps the
# scraper working and the IP unblocked.
# ---------------------------------------------------------------------------
SCRAPER_MIN_DELAY_MS=2500
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_CACHE_TTL_MS=300000
SCRAPER_MAX_RETRIES=3
# SCRAPER_USER_AGENT=

# Adverts cheaper than this are treated as noise - OLX cross-posts leak car
# parts into the car category with car-shaped attributes. 0 disables the guard.
SCRAPER_MIN_PRICE_PLN=2000

# ---------------------------------------------------------------------------
# Scheduler - background fetching of active filter groups
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_CRON=*/30 * * * *
FETCH_MAX_PAGES=5
FETCH_PAGE_SIZE=50
